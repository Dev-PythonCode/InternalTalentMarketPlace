@* DISABLED: AI-based Post Requirement Chat - Use PostRequirement.razor instead
@page "/post-requirement-chat-v2" *@
@inject IChatRequirementServiceV2 ChatService
@inject IRequirementService RequirementService
@inject IAuthService AuthService
@inject ISnackbar Snackbar
@inject NavigationManager Navigation

<!-- Header -->
<MudPaper Class="pa-6 mb-4" Elevation="0" Style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; border-radius: 12px;">
    <div class="d-flex align-items-center gap-3">
        <MudIcon Icon="@Icons.Material.Filled.SmartToy" Style="font-size: 40px;" />
        <div>
            <MudText Typo="Typo.h4" Style="color: white; margin-bottom: 4px;">
                ✨ AI-Powered Requirement Creator
            </MudText>
            <MudText Typo="Typo.body2" Style="color: rgba(255,255,255,0.9);">
                Let's build your requirement with intelligent assistance
            </MudText>
        </div>
    </div>
</MudPaper>

<MudGrid Spacing="3">
    <!-- Main Chat Area (8 cols) -->
    <MudItem xs="12" md="8">
        <!-- Chat Messages Container -->
        <MudPaper Class="pa-4 mb-3" Elevation="1" Style="height: 600px; overflow-y: auto; border-radius: 12px; background: linear-gradient(to bottom, #f8f9fa, #ffffff);">
            <div class="chat-messages">
                @if (_messages.Count == 0)
                {
                    <div style="text-align: center; padding: 40px 0; color: #999;">
                        <MudIcon Icon="@Icons.Material.Filled.SupportAgent" Style="font-size: 48px; margin-bottom: 16px;" />
                        <MudText Typo="Typo.body1">Loading assistant...</MudText>
                    </div>
                }

                @foreach (var message in _messages)
                {
                    @if (message.IsBot)
                    {
                        <div class="chat-message-bot mb-4">
                            <div class="d-flex gap-3">
                                <MudAvatar Style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
                                    <MudIcon Icon="@Icons.Material.Filled.SmartToy" />
                                </MudAvatar>
                                <div style="flex: 1; max-width: 80%;">
                                    <MudPaper Class="pa-4" Elevation="0" Style="background: white; border-radius: 12px; border-left: 4px solid #667eea;">
                                        <MudText Typo="Typo.body2" Style="white-space: pre-wrap; line-height: 1.6;">
                                            @((MarkupString)FormatMessageContent(message.Content))
                                        </MudText>
                                    </MudPaper>
                                </div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="chat-message-user mb-4">
                            <div class="d-flex gap-3 justify-end">
                                <div style="max-width: 80%; text-align: right;">
                                    <MudPaper Class="pa-4" Elevation="0" Style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; border-radius: 12px;">
                                        <MudText Typo="Typo.body2" Style="white-space: pre-wrap;">@message.Content</MudText>
                                    </MudPaper>
                                </div>
                                <MudAvatar Style="background: #e0e0e0; color: black;">
                                    <MudIcon Icon="@Icons.Material.Filled.Person" />
                                </MudAvatar>
                            </div>
                        </div>
                    }
                }
            </div>
        </MudPaper>

        <!-- Input Area -->
        @if (_currentMessage?.Step != "completed")
        {
            <MudPaper Class="pa-4" Elevation="1" Style="border-radius: 12px;">
                <!-- Quick Action Buttons -->
                @if (_currentMessage?.HasSuggestions == true && _currentMessage?.Suggestions?.Any() == true)
                {
                    <div class="mb-4">
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-3" Style="font-weight: 600; text-transform: uppercase;">
                            💡 Quick Options
                        </MudText>
                        <div class="quick-buttons-grid">
                            @foreach (var suggestion in _currentMessage.Suggestions)
                            {
                                <MudButton Variant="Variant.Filled" 
                                          Color="Color.Primary"
                                          Size="Size.Medium"
                                          OnClick="@(async () => await SendMessage(suggestion))"
                                          Disabled="@_isLoading"
                                          FullWidth="true"
                                          Style="border-radius: 8px; font-weight: 600;">
                                    @suggestion
                                </MudButton>
                            }
                        </div>
                        <MudDivider Class="my-4" />
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-3">
                            Or enter your own answer:
                        </MudText>
                    </div>
                }

                <!-- Input Fields Based on Step -->
                @switch (_currentMessage?.Step)
                {
                    case "duration":
                        <div class="mb-3">
                            <MudText Typo="Typo.subtitle2" Class="mb-2">Custom Duration</MudText>
                            <MudGrid Spacing="2">
                                <MudItem xs="6">
                                    <MudNumericField @bind-Value="_durationMonths" 
                                                    Label="Months" 
                                                    Min="0" 
                                                    Max="60"
                                                    Variant="Variant.Outlined"
                                                    Margin="Margin.Dense" />
                                </MudItem>
                                <MudItem xs="6">
                                    <MudNumericField @bind-Value="_durationYears" 
                                                    Label="Years" 
                                                    Min="0" 
                                                    Max="5"
                                                    Variant="Variant.Outlined"
                                                    Margin="Margin.Dense" />
                                </MudItem>
                            </MudGrid>
                            <MudButton Variant="Variant.Filled" 
                                      Color="Color.Primary" 
                                      OnClick="@(async () => await SendMessage($"{_durationYears} years, {_durationMonths} months"))"
                                      Disabled="@_isLoading"
                                      FullWidth="true"
                                      Class="mt-2">
                                Set Custom Duration
                            </MudButton>
                        </div>
                        break;

                    case "add_skills":
                        <div class="mb-3">
                            <MudAutocomplete T="Skill" 
                                            @bind-Value="_selectedSkill"
                                            SearchFunc="@SearchSkillsAsync"
                                            ToStringFunc="@(s => s?.SkillName ?? "")"
                                            Label="Search and select skill..." 
                                            Dense="false"
                                            Variant="Variant.Outlined"
                                            AnchorOrigin="Origin.BottomCenter"
                                            TransformOrigin="Origin.TopCenter"
                                            OpenIcon="@Icons.Material.Filled.Search"
                                            Clearable="true"
                                            ResetValueOnEmptyText="false"
                                            OnClearButtonClick="@(async () => _selectedSkill = null)"
                                            Disabled="@_isLoading">
                                <ItemTemplate>
                                    <div class="d-flex align-items-center gap-2">
                                        <MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Small" Color="Color.Success" />
                                        <MudText>@context.SkillName</MudText>
                                    </div>
                                </ItemTemplate>
                                <NoItemsTemplate>
                                    <MudText Align="Align.Center" Class="px-4 py-3">No skills found</MudText>
                                </NoItemsTemplate>
                            </MudAutocomplete>
                            @if (_selectedSkill != null)
                            {
                                <MudButton Variant="Variant.Filled" 
                                          Color="Color.Success"
                                          OnClick="@(async () => await SendMessage(_selectedSkill.SkillName))"
                                          Disabled="@_isLoading"
                                          FullWidth="true"
                                          Class="mt-2">
                                    ✓ Select @_selectedSkill.SkillName
                                </MudButton>
                            }
                        </div>
                        break;

                    default:
                        <MudTextField @bind-Value="_userInput" 
                                      Label="Your answer..." 
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      OnKeyDown="@OnInputKeyDown"
                                      Disabled="@_isLoading"
                                      FullWidth="true"
                                      Lines="3"
                                      Immediate="true" />
                        break;
                }

                <!-- Action Buttons -->
                <div class="mt-4 d-flex gap-2">
                    <MudButton Variant="Variant.Filled" 
                              Color="Color.Primary"
                              OnClick="@(async () => await SendMessage())"
                              Disabled="@(_isLoading || !CanSendMessage())"
                              FullWidth="true"
                              Size="Size.Large"
                              Style="border-radius: 8px; font-weight: 600;">
                        @if (_isLoading)
                        {
                            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                        }
                        <MudIcon Icon="@Icons.Material.Filled.Send" Class="mr-2" />
                        Send
                    </MudButton>
                    <MudButton Variant="Variant.Outlined" 
                              Color="Color.Default"
                              OnClick="ResetChat"
                              Disabled="@_isLoading"
                              Size="Size.Large"
                              Style="border-radius: 8px;">
                        ↻
                    </MudButton>
                </div>
            </MudPaper>
        }
        else
        {
            <!-- Submission Section -->
            <MudPaper Class="pa-4 mud-theme-success" Elevation="2" Style="border-radius: 12px; background: linear-gradient(135deg, #84fab0 0%, #8fd3f4 100%);">
                <MudAlert Severity="Severity.Success" Class="mb-4" Style="border-radius: 8px;">
                    ✅ <strong>Perfect!</strong> Your requirement is ready to be published.
                </MudAlert>
                <MudGrid Spacing="2">
                    <MudItem xs="12" md="6">
                        <MudButton Variant="Variant.Filled" 
                                  Color="Color.Success"
                                  OnClick="SubmitRequirement"
                                  Disabled="@_isSubmitting"
                                  FullWidth="true"
                                  Size="Size.Large"
                                  Style="border-radius: 8px; font-weight: 600;">
                            @if (_isSubmitting)
                            {
                                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                            }
                            else
                            {
                                <MudIcon Icon="@Icons.Material.Filled.CloudUpload" Class="mr-2" />
                            }
                            Post Requirement
                        </MudButton>
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <MudButton Variant="Variant.Outlined" 
                                  Color="Color.Default"
                                  OnClick="ResetChat"
                                  FullWidth="true"
                                  Size="Size.Large"
                                  Style="border-radius: 8px;">
                            ↻ Start Over
                        </MudButton>
                    </MudItem>
                </MudGrid>
            </MudPaper>
        }
    </MudItem>

    <!-- Side Panel - Progress & Summary -->
    <MudItem xs="12" md="4">
        <MudPaper Class="pa-4" Style="position: sticky; top: 20px; border-radius: 12px; background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);">
            <!-- Progress Header -->
            <div class="d-flex align-items-center gap-2 mb-4">
                <MudIcon Icon="@Icons.Material.Filled.TrendingUp" Color="Color.Primary" />
                <MudText Typo="Typo.subtitle1" Style="font-weight: 600;">Progress Tracker</MudText>
            </div>

            <!-- Current Step -->
            @{
                var stepInfo = _currentMessage?.Step switch
                {
                    "title" => ("📝", "Requirement Title", 1),
                    "description" => ("📄", "Job Description", 2),
                    "location" => ("📍", "Location", 3),
                    "duration" => ("⏱️", "Duration", 4),
                    "priority" => ("🚩", "Priority", 5),
                    "add_skills" => ("🔧", "Required Skills", 6),
                    "skill_experience" => ("📊", "Years Experience", 7),
                    "skill_proficiency" => ("⭐", "Proficiency Level", 8),
                    "skill_mandatory" => ("❗", "Mandatory Status", 9),
                    "add_more_skills" => ("➕", "Additional Skills", 10),
                    "review" => ("✔️", "Review & Confirm", 11),
                    "completed" => ("✅", "Ready to Post", 12),
                    _ => ("⏳", "Starting...", 0)
                };
            }

            <MudProgressLinear Value="@(stepInfo.Item3 * 8.33)" Color="Color.Primary" Class="mb-3" Style="border-radius: 4px; height: 8px;" />

            <MudPaper Class="pa-3 mb-4" Elevation="0" Style="background: white; border-left: 4px solid #667eea; border-radius: 8px;">
                <MudText Typo="Typo.body2" Style="font-weight: 600;">
                    @stepInfo.Item1 @stepInfo.Item2
                </MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">
                    Step @stepInfo.Item3 of 12
                </MudText>
            </MudPaper>

            <MudDivider Class="my-3" />

            <!-- Requirement Summary -->
            <MudText Typo="Typo.subtitle2" Class="mb-3" Style="font-weight: 600;">
                <MudIcon Icon="@Icons.Material.Filled.AssignmentInd" Class="mr-1" />
                Summary
            </MudText>

            @if (_currentState != null)
            {
                <div style="background: white; padding: 12px; border-radius: 8px; font-size: 13px; line-height: 1.8;">
                    @if (!string.IsNullOrEmpty(_currentState.Requirement.Title))
                    {
                        <div class="mb-3 pb-2" style="border-bottom: 1px solid #eee;">
                            <div style="color: #666; font-size: 11px; text-transform: uppercase; letter-spacing: 0.5px;">Title</div>
                            <MudText Typo="Typo.body2" Style="color: #333; font-weight: 500;">@_currentState.Requirement.Title</MudText>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(_currentState.Requirement.Location))
                    {
                        <div class="mb-3 pb-2" style="border-bottom: 1px solid #eee;">
                            <div style="color: #666; font-size: 11px; text-transform: uppercase; letter-spacing: 0.5px;">📍 Location</div>
                            <MudText Typo="Typo.body2" Style="color: #333;">@_currentState.Requirement.Location</MudText>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(_currentState.Requirement.Duration))
                    {
                        <div class="mb-3 pb-2" style="border-bottom: 1px solid #eee;">
                            <div style="color: #666; font-size: 11px; text-transform: uppercase; letter-spacing: 0.5px;">⏱️ Duration</div>
                            <MudText Typo="Typo.body2" Style="color: #333;">@_currentState.Requirement.Duration</MudText>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(_currentState.Requirement.Priority))
                    {
                        <div class="mb-3 pb-2" style="border-bottom: 1px solid #eee;">
                            <div style="color: #666; font-size: 11px; text-transform: uppercase; letter-spacing: 0.5px;">🚩 Priority</div>
                            <MudChip T="string" 
                                    Size="Size.Small" 
                                    Color="@GetPriorityColor(_currentState.Requirement.Priority)"
                                    Variant="Variant.Filled"
                                    Style="color: white;">
                                @_currentState.Requirement.Priority
                            </MudChip>
                        </div>
                    }

                    @if (_currentState.Requirement.RequirementSkills.Any())
                    {
                        <div>
                            <div style="color: #666; font-size: 11px; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 8px;">🔧 Skills (@_currentState.Requirement.RequirementSkills.Count)</div>
                            <div style="display: flex; flex-direction: column; gap: 6px;">
                                @foreach (var skill in _currentState.Requirement.RequirementSkills)
                                {
                                    <MudChip T="string" 
                                            Size="Size.Small"
                                            Color="@(skill.IsMandatory ? Color.Error : Color.Info)"
                                            Variant="Variant.Filled"
                                            Style="color: white; justify-content: flex-start;">
                                        <MudIcon Icon="@(skill.IsMandatory ? Icons.Material.Filled.Star : Icons.Material.Filled.StarBorder)" Size="Size.Small" Class="mr-1" />
                                        @skill.Skill?.SkillName (@skill.MinYearsRequired yrs, @skill.ProficiencyLevel)
                                    </MudChip>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        </MudPaper>
    </MudItem>
</MudGrid>

@code {
    private List<RequirementChatMessage> _messages = new();
    private string _userInput = string.Empty;
    private Skill? _selectedSkill = null;
    private bool _isLoading = false;
    private bool _isSubmitting = false;
    private RequirementChatMessage? _currentMessage;
    private RequirementChatState? _currentState;
    private int _durationYears = 1;
    private int _durationMonths = 0;

    protected override async Task OnInitializedAsync()
    {
        await InitializeChat();
    }

    private async Task InitializeChat()
    {
        _isLoading = true;
        _messages.Clear();
        try
        {
            var greeting = await ChatService.GetInitialGreetingAsync();
            _messages.Add(greeting);
            _currentMessage = greeting;
            await UpdateState();
        }
        finally
        {
            _isLoading = false;
        }
    }

    private bool CanSendMessage()
    {
        return _currentMessage?.Step switch
        {
            "add_skills" => _selectedSkill != null,
            "duration" => _durationYears > 0 || _durationMonths > 0,
            _ => !string.IsNullOrWhiteSpace(_userInput)
        };
    }

    private async Task SendMessage(string? optionalInput = null)
    {
        string input = optionalInput ?? _userInput ?? _selectedSkill?.SkillName ?? "";
        
        if (string.IsNullOrWhiteSpace(input) || _isLoading)
            return;

        // Add user message to chat
        _messages.Add(new RequirementChatMessage
        {
            Content = input,
            IsBot = false,
            Timestamp = DateTime.UtcNow
        });

        // Clear inputs
        _userInput = string.Empty;
        _selectedSkill = null;
        _durationYears = 1;
        _durationMonths = 0;
        _isLoading = true;

        try
        {
            // Process with service
            var response = await ChatService.ProcessUserInputAsync(input);
            _messages.Add(response);
            _currentMessage = response;
            await UpdateState();
            
            // Auto scroll to bottom
            await Task.Delay(100);
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
            _logger.LogError(ex, "Error processing chat input");
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task UpdateState()
    {
        try
        {
            _currentState = await ChatService.GetCurrentStateAsync();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            _logger.LogError(ex, "Error updating state");
        }
    }

    private async Task ResetChat()
    {
        await ChatService.ResetAsync();
        await InitializeChat();
    }

    private async Task SubmitRequirement()
    {
        _isSubmitting = true;
        try
        {
            var requirement = ChatService.GetCurrentRequirement();
            var employee = await AuthService.GetCurrentEmployeeAsync();

            if (employee == null)
            {
                Snackbar.Add("❌ Not authenticated. Please log in.", Severity.Error);
                return;
            }

            // Set metadata
            requirement.PostedById = employee.EmployeeId;
            requirement.PostedDate = DateTime.UtcNow;
            requirement.IsActive = true;
            requirement.Status = "Open";

            // Create requirement
            var created = await RequirementService.CreateAsync(requirement);

            // Add skills
            if (requirement.RequirementSkills?.Any() == true)
            {
                foreach (var skill in requirement.RequirementSkills)
                {
                    skill.RequirementId = created.RequirementId;
                    skill.ProficiencyLevel = skill.ProficiencyLevel ?? "Intermediate";
                    await RequirementService.AddSkillAsync(skill);
                }
            }

            Snackbar.Add("🎉 Requirement posted successfully!", Severity.Success);
            await Task.Delay(1500);
            Navigation.NavigateTo("/requirements");
        }
        catch (Exception ex)
        {
            _logger.LogError(ex, "Error submitting requirement");
            Snackbar.Add($"❌ Error: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private async Task<IEnumerable<Skill>> SearchSkillsAsync(string value, CancellationToken cancellationToken)
    {
        try
        {
            if (string.IsNullOrWhiteSpace(value))
                return await Task.FromResult(await ChatService.GetSkillSuggestionsAsync(""));

            return await Task.FromResult(await ChatService.GetSkillSuggestionsAsync(value));
        }
        catch
        {
            return await Task.FromResult(new List<Skill>());
        }
    }

    private async Task OnInputKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Enter" && !args.ShiftKey && !args.CtrlKey)
        {
            await SendMessage();
        }
    }

    private string FormatMessageContent(string content)
    {
        return content
            .Replace("**", "<strong>")
            .Replace("**", "</strong>")
            .Replace("\n", "<br />");
    }

    private Color GetPriorityColor(string priority) => priority switch
    {
        "High" => Color.Error,
        "Medium" => Color.Warning,
        "Low" => Color.Success,
        _ => Color.Default
    };

    [Inject]
    private ILogger<PostRequirementChatV2> _logger { get; set; } = null!;
}

<style>
    .chat-messages {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
    }

    .chat-message-bot {
        display: flex;
        justify-content: flex-start;
    }

    .chat-message-user {
        display: flex;
        justify-content: flex-end;
    }

    .quick-buttons-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
        gap: 8px;
    }
</style>
