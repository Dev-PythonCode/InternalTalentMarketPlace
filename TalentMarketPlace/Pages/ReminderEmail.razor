@page "/admin/reminder-email"
@inject ILevelReminderService LevelReminderService
@inject IEmployeeService EmployeeService
@inject IEmailService EmailService
@inject IScheduledEmailService ScheduledEmailService
@inject ISnackbar Snackbar
@using TalentMarketPlace.Services.Interfaces
@using TalentMarketPlace.Models

<MudText Typo="Typo.h4" Class="mb-2">Configure Reminder Emails</MudText>
<MudText Typo="Typo.body1" Color="Color.Secondary" Class="mb-4">
    Set automated level-based reminders for employees to update their skills and certificates
</MudText>

<MudGrid>
    <!-- Level-Based Configuration Card -->
    <MudItem xs="12" lg="6">
        <MudCard>
            <MudCardContent>
                <MudText Typo="Typo.h6" Class="mb-4">
                    <MudIcon Icon="@Icons.Material.Filled.Settings" Class="mr-2" />
                    Level-Based Reminder Settings
                </MudText>

                <!-- Employee Level Dropdown -->
                <MudSelect T="string" @bind-Value="_selectedLevel" Label="Employee Level" 
                           Variant="Variant.Outlined" Class="mb-3">
                    @for (int i = 1; i <= 10; i++)
                    {
                        var level = $"L{i}";
                        <MudSelectItem T="string" Value="@level">Level @i (L@i)</MudSelectItem>
                    }
                </MudSelect>

                <!-- Duration Dropdown -->
                <MudSelect T="string" @bind-Value="_selectedDuration" Label="Reminder Interval" 
                           Variant="Variant.Outlined" Class="mb-3">
                    <MudSelectItem T="string" Value="@("Monthly")">Monthly</MudSelectItem>
                    <MudSelectItem T="string" Value="@("Quarterly")">Quarterly</MudSelectItem>
                    <MudSelectItem T="string" Value="@("Half Yearly")">Half Yearly</MudSelectItem>
                    <MudSelectItem T="string" Value="@("Yearly")">Yearly</MudSelectItem>
                </MudSelect>

                <!-- Default Email Count -->
                <MudNumericField @bind-Value="_emailCount" Label="Email Count per Duration" 
                                 Variant="Variant.Outlined" Min="1" Max="10" Class="mb-3"
                                 HelperText="Number of reminder emails to send in each interval" />

                <!-- Save Button -->
                <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true"
                           OnClick="SaveLevelSetting" Disabled="@_isSaving"
                           StartIcon="@Icons.Material.Filled.Save">
                    @if (_isSaving)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                        <span class="ml-2">Saving...</span>
                    }
                    else
                    {
                        <span>@(_editingId.HasValue ? "Update Setting" : "Save Setting")</span>
                    }
                </MudButton>

                @if (_editingId.HasValue)
                {
                    <MudButton Variant="Variant.Outlined" Color="Color.Secondary" FullWidth="true"
                               OnClick="CancelEdit" Class="mt-2">
                        Cancel Edit
                    </MudButton>
                }
            </MudCardContent>
        </MudCard>
    </MudItem>

    <!-- Schedule Options Card -->
    <MudItem xs="12" lg="6">
        <MudCard>
            <MudCardContent>
                <MudText Typo="Typo.h6" Class="mb-4">
                    <MudIcon Icon="@Icons.Material.Filled.Schedule" Class="mr-2" />
                    One-Time Email Schedule
                </MudText>

                <!-- Subject -->
                <MudTextField @bind-Value="_subject" Label="Subject" Variant="Variant.Outlined"
                              Class="mb-3" />

                <!-- Email Body -->
                <MudTextField @bind-Value="_emailBody" Label="Email Body" Variant="Variant.Outlined"
                              Lines="6" Class="mb-3" />

                <!-- Schedule Date & Time -->
                <MudDatePicker @bind-Date="_scheduledDate" Label="Schedule Date" Variant="Variant.Outlined"
                               Class="mb-3" MinDate="DateTime.Today" />
                <MudTimePicker @bind-Time="_scheduledTime" Label="Schedule Time" Variant="Variant.Outlined"
                               Class="mb-3" />

                <!-- Quick Templates -->
                <MudText Typo="Typo.subtitle2" Class="mb-2">Quick Templates:</MudText>
                <MudButtonGroup Variant="Variant.Outlined" Size="Size.Small" Class="mb-3">
                    <MudButton OnClick="LoadDefaultTemplate">Default</MudButton>
                    <MudButton OnClick="LoadUrgentTemplate">Urgent</MudButton>
                </MudButtonGroup>

                <!-- Schedule Button -->
                <MudButton Variant="Variant.Filled" Color="Color.Success" FullWidth="true"
                           OnClick="ScheduleOneTimeEmail" Disabled="@_isScheduling"
                           StartIcon="@Icons.Material.Filled.Schedule">
                    @if (_isScheduling)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                        <span class="ml-2">Scheduling...</span>
                    }
                    else
                    {
                        <span>Schedule Email</span>
                    }
                </MudButton>
            </MudCardContent>
        </MudCard>
    </MudItem>

    <!-- Level Settings Grid -->
    <MudItem xs="12">
        <MudCard>
            <MudCardContent>
                <MudText Typo="Typo.h6" Class="mb-3">
                    <MudIcon Icon="@Icons.Material.Filled.List" Class="mr-2" />
                    Configured Level Settings
                </MudText>

                @if (_levelSettings.Any())
                {
                    <MudTable Items="_levelSettings" Hover="true" Striped="true" Dense="true">
                        <HeaderContent>
                            <MudTh>Level</MudTh>
                            <MudTh>Duration</MudTh>
                            <MudTh>Email Count</MudTh>
                            <MudTh>Created Date</MudTh>
                            <MudTh>Last Modified</MudTh>
                            <MudTh>Actions</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="Level">
                                <MudChip T="string" Size="Size.Small" Color="Color.Primary">@context.EmployeeLevel</MudChip>
                            </MudTd>
                            <MudTd DataLabel="Duration">@context.Duration</MudTd>
                            <MudTd DataLabel="Email Count">@context.DefaultEmailCount</MudTd>
                            <MudTd DataLabel="Created Date">@context.CreatedDate.ToString("MMM dd, yyyy")</MudTd>
                            <MudTd DataLabel="Last Modified">
                                @(context.LastModifiedDate?.ToString("MMM dd, yyyy") ?? "-")
                            </MudTd>
                            <MudTd DataLabel="Actions">
                                <MudButtonGroup Size="Size.Small" Variant="Variant.Outlined">
                                    <MudIconButton Icon="@Icons.Material.Filled.Edit" 
                                                   Color="Color.Info" Size="Size.Small"
                                                   OnClick="@(() => EditSetting(context))" />
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete" 
                                                   Color="Color.Error" Size="Size.Small"
                                                   OnClick="@(() => DeleteSetting(context.Id))" />
                                </MudButtonGroup>
                            </MudTd>
                        </RowTemplate>
                    </MudTable>
                }
                else
                {
                    <MudAlert Severity="Severity.Info">
                        No level settings configured yet. Add your first setting above.
                    </MudAlert>
                }
            </MudCardContent>
        </MudCard>
    </MudItem>
</MudGrid>

@code {
    private List<LevelReminderSetting> _levelSettings = new();
    
    // Level Settings Form
    private string _selectedLevel = "L1";
    private string _lastSelectedLevel = "L1";
    private string _selectedDuration = "Quarterly";
    private int _emailCount = 1;
    private int? _editingId = null;
    private bool _isSaving = false;

    // Schedule Email Form
    private string _subject = "";
    private string _emailBody = "";
    private DateTime? _scheduledDate;
    private TimeSpan? _scheduledTime;
    private bool _isScheduling = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadLevelSettings();
        LoadDefaultTemplate();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Check if level changed and load existing settings
        if (_selectedLevel != _lastSelectedLevel)
        {
            _lastSelectedLevel = _selectedLevel;
            await OnLevelSelected(_selectedLevel);
            StateHasChanged();
        }
    }

    private async Task LoadLevelSettings()
    {
        try
        {
            _levelSettings = await LevelReminderService.GetAllSettingsAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading settings: {ex.Message}", Severity.Error);
        }
    }

    private async Task OnLevelSelected(string selectedLevel)
    {
        _selectedLevel = selectedLevel;
        
        // Load existing setting for this level if any
        var existing = await LevelReminderService.GetSettingByLevelAsync(selectedLevel);
        if (existing != null)
        {
            _selectedDuration = existing.Duration;
            _emailCount = existing.DefaultEmailCount;
            _editingId = existing.Id;
            Snackbar.Add($"Loaded existing setting for {selectedLevel}", Severity.Info);
        }
        else
        {
            // Reset to defaults for new level
            _selectedDuration = "Quarterly";
            _emailCount = 1;
            _editingId = null;
        }
    }

    private async Task SaveLevelSetting()
    {
        if (string.IsNullOrEmpty(_selectedLevel))
        {
            Snackbar.Add("Please select a level", Severity.Warning);
            return;
        }

        _isSaving = true;
        try
        {
            var setting = new LevelReminderSetting
            {
                EmployeeLevel = _selectedLevel,
                Duration = _selectedDuration,
                DefaultEmailCount = _emailCount,
                CreatedBy = "Admin", // Get from authentication
                ModifiedBy = "Admin"
            };

            if (_editingId.HasValue)
            {
                // Update existing
                setting.Id = _editingId.Value;
                await LevelReminderService.UpdateSettingAsync(setting);
                Snackbar.Add($"Updated setting for {_selectedLevel}", Severity.Success);
            }
            else
            {
                // Create new
                await LevelReminderService.CreateSettingAsync(setting);
                Snackbar.Add($"Created setting for {_selectedLevel}", Severity.Success);
            }

            await LoadLevelSettings();
            CancelEdit();
        }
        catch (InvalidOperationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Warning);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error saving setting: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isSaving = false;
        }
    }

    private void EditSetting(LevelReminderSetting setting)
    {
        _selectedLevel = setting.EmployeeLevel;
        _selectedDuration = setting.Duration;
        _emailCount = setting.DefaultEmailCount;
        _editingId = setting.Id;
        Snackbar.Add($"Editing setting for {setting.EmployeeLevel}", Severity.Info);
    }

    private async Task DeleteSetting(int id)
    {
        try
        {
            await LevelReminderService.DeleteSettingAsync(id);
            Snackbar.Add("Setting deleted successfully", Severity.Success);
            await LoadLevelSettings();
            
            if (_editingId == id)
            {
                CancelEdit();
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error deleting setting: {ex.Message}", Severity.Error);
        }
    }

    private void CancelEdit()
    {
        _editingId = null;
        _selectedLevel = "L1";
        _selectedDuration = "Quarterly";
        _emailCount = 1;
    }

    private async Task ScheduleOneTimeEmail()
    {
        if (string.IsNullOrWhiteSpace(_subject) || string.IsNullOrWhiteSpace(_emailBody))
        {
            Snackbar.Add("Please fill in subject and email body", Severity.Warning);
            return;
        }

        if (_scheduledDate == null || _scheduledTime == null)
        {
            Snackbar.Add("Please select date and time", Severity.Warning);
            return;
        }

        _isScheduling = true;
        try
        {
            var employees = await EmployeeService.GetAllAsync();
            var scheduledDateTime = _scheduledDate.Value.Date + _scheduledTime.Value;

            var scheduledEmail = new TalentMarketPlace.Models.ScheduledEmail
            {
                Recipients = string.Join(";", employees.Select(e => e.Email)),
                Subject = _subject,
                Body = _emailBody,
                CcAddress = null,
                ScheduledTime = scheduledDateTime,
                CreatedBy = "Admin"
            };

            var scheduledId = await ScheduledEmailService.CreateScheduledEmailAsync(scheduledEmail);
            Snackbar.Add($"Email scheduled for {scheduledDateTime:MMM dd, yyyy hh:mm tt}", Severity.Success);

            // Clear form
            _subject = "";
            _emailBody = "";
            _scheduledDate = null;
            _scheduledTime = null;
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error scheduling email: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isScheduling = false;
        }
    }

    private void LoadDefaultTemplate()
    {
        var quarter = GetCurrentQuarter();
        var year = DateTime.Now.Year;

        _subject = $"Reminder: Update Your Skills - Q{quarter} {year}";
        _emailBody = $@"Dear {{EmployeeName}},

Please update your profile with your latest skills and certificates for Q{quarter} {year}.

Login to the Skills Management System to:
• Review and update your current skills
• Add new skills you've acquired
• Upload recent certificates

Thank you,
HR Team";
    }

    private void LoadUrgentTemplate()
    {
        var quarter = GetCurrentQuarter();
        var year = DateTime.Now.Year;

        _subject = $"URGENT: Skills Update Required - Q{quarter} {year}";
        _emailBody = $@"Dear {{EmployeeName}},

ACTION REQUIRED: Please update your skills profile immediately.

This is mandatory for project assignments and performance reviews.

Thank you,
HR Team";
    }

    private int GetCurrentQuarter()
    {
        return (DateTime.Now.Month - 1) / 3 + 1;
    }
}
