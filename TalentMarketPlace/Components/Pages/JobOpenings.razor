    }
}

<style>
    .hover-shadow {
        transition: box-shadow 0.3s ease-in-out;
    }

    .hover-shadow:hover {
        box-shadow: 0 1.5rem 3rem rgba(0, 0, 0, 0.15) !important;
    }

    .btn-group {
        display: flex;
        gap: 0.5rem;
    }

    .btn-group .btn {
        flex: 1;
    }

    .modal-lg {
        max-width: 900px;
    }

    .card-title {
        font-size: 1rem;
    }

    h7 {
        font-size: 0.875rem;
    }

    h8 {
        font-size: 0.8125rem;
    }
</style>
