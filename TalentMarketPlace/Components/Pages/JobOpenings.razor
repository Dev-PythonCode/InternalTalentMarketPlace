@page "/job-openings"
@using System.Text.Json
@using System.Net.Http.Json
@inject HttpClient Http
@inject IJSRuntime JS

<PageTitle>Current Job Openings</PageTitle>

<!-- ⚠️ DEPRECATION NOTICE: This page is for external job openings. 
     For internal opportunities, use /job-board instead which has better 
     skill matching, learning path recommendations, and career guidance. -->

<div class="container-fluid mt-4">
    <div class="row mb-4">
        <div class="col-12">
            <h1 class="mb-3">
                <i class="bi bi-briefcase"></i> Current Job Openings
            </h1>
            <p class="text-muted">Explore available positions and view personalized learning paths for required technologies</p>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="row">
            <div class="col-12">
                <div class="alert alert-info" role="alert">
                    <i class="bi bi-hourglass-split"></i> Loading job openings...
                </div>
            </div>
        </div>
    }
    else if (jobOpenings == null || jobOpenings.Count == 0)
    {
        <div class="row">
            <div class="col-12">
                <div class="alert alert-warning" role="alert">
                    <i class="bi bi-exclamation-triangle"></i> No job openings available at this time.
                </div>
            </div>
        </div>
    }
    else
    {
        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="row">
                <div class="col-12">
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <i class="bi bi-exclamation-circle"></i> @errorMessage
                        <button type="button" class="btn-close" @onclick="@(() => errorMessage = "")"
                                aria-label="Close"></button>
                    </div>
                </div>
            </div>
        }

        <div class="row">
            @foreach (var job in jobOpenings)
            {
                <div class="col-md-6 col-lg-4 mb-4">
                    <div class="card h-100 hover-shadow">
                        <div class="card-body">
                            <h5 class="card-title">@job.JobTitle</h5>
                            <h6 class="card-subtitle mb-2 text-muted">@job.Company</h6>
                            <p class="card-text">
                                <i class="bi bi-geo-alt"></i> @job.Location
                            </p>
                            <p class="card-text small">@job.Description</p>

                            <div class="mb-3">
                                <p class="mb-1">
                                    <strong>Salary:</strong> @job.SalaryRange
                                </p>
                                <p class="mb-1">
                                    <strong>Experience:</strong> @job.ExperienceRequired
                                </p>
                            </div>

                            <div class="mb-3">
                                <h7>Required Technologies:</h7>
                                <div>
                                    @foreach (var tech in job.RequiredTechnologies)
                                    {
                                        <span class="badge bg-primary me-1">@tech</span>
                                    }
                                </div>
                            </div>

                            <div class="btn-group" role="group">
                                <button class="btn btn-sm btn-outline-secondary"
                                        @onclick="@(() => ViewJobDetails(job))">
                                    <i class="bi bi-file-text"></i> Details
                                </button>
                                <button class="btn btn-sm btn-primary"
                                        @onclick="@(() => ViewLearningPath(job))">
                                    <i class="bi bi-book"></i> Learning Path
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<!-- Job Details Modal -->
<div class="modal fade" id="jobDetailsModal" tabindex="-1" aria-labelledby="jobDetailsLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="jobDetailsLabel">
                    <i class="bi bi-briefcase"></i> @selectedJob?.JobTitle
                </h5>
                <button type="button" class="btn-close" @onclick="@(async () => await JS.InvokeVoidAsync("hideModal", "jobDetailsModal"))"
                        aria-label="Close"></button>
            </div>
            <div class="modal-body">
                @if (selectedJob != null)
                {
                    <div class="mb-3">
                        <h6>Company</h6>
                        <p>@selectedJob.Company</p>
                    </div>

                    <div class="mb-3">
                        <h6>Location</h6>
                        <p>@selectedJob.Location</p>
                    </div>

                    <div class="mb-3">
                        <h6>Description</h6>
                        <p>@selectedJob.Description</p>
                    </div>

                    <div class="mb-3">
                        <h6>Salary Range</h6>
                        <p>@selectedJob.SalaryRange</p>
                    </div>

                    <div class="mb-3">
                        <h6>Experience Required</h6>
                        <p>@selectedJob.ExperienceRequired</p>
                    </div>

                    <div class="mb-3">
                        <h6>Required Technologies</h6>
                        <div>
                            @foreach (var tech in selectedJob.RequiredTechnologies)
                            {
                                <span class="badge bg-primary me-1 mb-1">@tech</span>
                            }
                        </div>
                    </div>

                    <div class="mb-3">
                        <h6>Nice to Have Technologies</h6>
                        <div>
                            @foreach (var tech in selectedJob.NiceToHaveTechnologies)
                            {
                                <span class="badge bg-secondary me-1 mb-1">@tech</span>
                            }
                        </div>
                    </div>

                    <div class="mb-3">
                        <h6>Responsibilities</h6>
                        <ul>
                            @foreach (var resp in selectedJob.Responsibilities)
                            {
                                <li>@resp</li>
                            }
                        </ul>
                    </div>
                }
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary"
                        @onclick="@(async () => await JS.InvokeVoidAsync("hideModal", "jobDetailsModal"))">
                    Close
                </button>
                <button type="button" class="btn btn-success"
                        @onclick="@(async () => await ViewLearningPathForSelected())">
                    <i class="bi bi-book"></i> View Learning Path
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Learning Path Modal -->
<div class="modal fade modal-lg" id="learningPathModal" tabindex="-1" aria-labelledby="learningPathLabel"
     aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="learningPathLabel">
                    <i class="bi bi-book"></i> Learning Path
                </h5>
                <button type="button" class="btn-close"
                        @onclick="@(async () => await JS.InvokeVoidAsync("hideModal", "learningPathModal"))"
                        aria-label="Close"></button>
            </div>
            <div class="modal-body">
                @if (isLoadingLearningPath)
                {
                    <div class="text-center">
                        <div class="spinner-border" role="status">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                        <p class="mt-2">Loading learning paths...</p>
                    </div>
                }
                else if (learningPathData != null)
                {
                    <div class="mb-4">
                        <h5>Required Technologies for: <strong>@selectedJob?.JobTitle</strong></h5>
                        <div class="mt-3">
                            @foreach (var tech in selectedJob?.RequiredTechnologies ?? new List<string>())
                            {
                                <span class="badge bg-primary me-2 mb-2">@tech</span>
                            }
                        </div>
                    </div>

                    <hr />

                    <div class="mb-4">
                        <label class="form-label">
                            <strong>Select Difficulty Level:</strong>
                        </label>
                        <div class="btn-group mb-3" role="group">
                            <input type="radio" class="btn-check" name="difficultyLevel" value="Beginner"
                                   @onchange="@((ChangeEventArgs e) => HandleDifficultyChange((string?)e.Value ?? "Beginner"))"
                                   @checked="selectedDifficulty == \"Beginner\"" />
                            <label class="btn btn-outline-primary">Beginner</label>

                            <input type="radio" class="btn-check" name="difficultyLevel" value="Intermediate"
                                   @onchange="@((ChangeEventArgs e) => HandleDifficultyChange((string?)e.Value ?? "Intermediate"))"
                                   @checked="selectedDifficulty == \"Intermediate\"" />
                            <label class="btn btn-outline-primary">Intermediate</label>

                            <input type="radio" class="btn-check" name="difficultyLevel" value="Advanced"
                                   @onchange="@((ChangeEventArgs e) => HandleDifficultyChange((string?)e.Value ?? "Advanced"))"
                                   @checked="selectedDifficulty == \"Advanced\"" />
                            <label class="btn btn-outline-primary">Advanced</label>
                        </div>
                    </div>

                    <hr />

                    <!-- Matched Technologies and Resources -->
                    @if (learningPathData.matched_technologies != null && learningPathData.matched_technologies.Count > 0)
                    {
                        <div class="mb-4">
                            <h6 class="mb-3">
                                <i class="bi bi-gear"></i> Recommended Learning Resources
                            </h6>

                            @foreach (var techEntry in learningPathData.matched_technologies)
                            {
                                <div class="card mb-3">
                                    <div class="card-header bg-light">
                                        <h6 class="mb-0">
                                            <i class="bi bi-code-square"></i> @techEntry.Key
                                        </h6>
                                        <small class="text-muted">
                                            Category: @(techEntry.Value.category ?? "N/A")
                                        </small>
                                    </div>
                                    <div class="card-body">
                                        @if (techEntry.Value.learning_resources != null && techEntry.Value.learning_resources.Count > 0)
                                        {
                                            @foreach (var diffLevel in techEntry.Value.learning_resources)
                                            {
                                                <div class="mb-3">
                                                    <h7 class="badge bg-info text-dark mb-2">@diffLevel.Key</h7>
                                                    <div>
                                                        @if (diffLevel.Value != null && ((System.Collections.IEnumerable)diffLevel.Value).Cast<object>().Any())
                                                        {
                                                            @foreach (var course in (System.Collections.IEnumerable)(diffLevel.Value ?? new List<object>()))
                                                            {
                                                                try
                                                                {
                                                                    var courseObj = JsonSerializer.Deserialize<Dictionary<string, JsonElement>>(JsonSerializer.Serialize(course));
                                                                    if (courseObj != null && courseObj.ContainsKey("title") && courseObj.ContainsKey("provider"))
                                                                    {
                                                                        var title = GetJsonElementString(courseObj, "title", "Untitled Course");
                                                                        var provider = GetJsonElementString(courseObj, "provider", "Unknown Provider");
                                                                        var duration = GetJsonElementString(courseObj, "duration", "N/A");
                                                                        var cost = GetJsonElementString(courseObj, "cost", "Free");
                                                                        var description = GetJsonElementString(courseObj, "description", "No description available");
                                                                        var url = GetJsonElementString(courseObj, "url", "#");

                                                                        <div class="card mb-2">
                                                                            <div class="card-body p-2">
                                                                                <h8 class="card-title mb-1">@title</h8>
                                                                                <p class="card-text small mb-1">
                                                                                    <strong>Provider:</strong> @provider
                                                                                </p>
                                                                                <p class="card-text small mb-1">
                                                                                    <strong>Duration:</strong> @duration
                                                                                </p>
                                                                                <p class="card-text small mb-1">
                                                                                    <strong>Cost:</strong> @cost
                                                                                </p>
                                                                                @if (courseObj.ContainsKey("rating"))
                                                                                {
                                                                                    try
                                                                                    {
                                                                                        var rating = courseObj["rating"];
                                                                                        var ratingValue = rating.GetDouble();
                                                                                        <p class="card-text small mb-2">
                                                                                            <strong>Rating:</strong>
                                                                                            <span class="text-warning">@(ratingValue.ToString("F1")) ⭐</span>
                                                                                        </p>
                                                                                    }
                                                                                    catch { }
                                                                                }
                                                                                <p class="card-text small text-muted mb-2">@description</p>
                                                                                <a href="@url" target="_blank" class="btn btn-sm btn-primary">
                                                                                    <i class="bi bi-box-arrow-up-right"></i> View Course
                                                                                </a>
                                                                            </div>
                                                                        </div>
                                                                    }
                                                                }
                                                                catch (Exception ex)
                                                                {
                                                                    <div class="alert alert-warning p-2 mb-2">
                                                                        <small>Error loading course: @ex.Message</small>
                                                                    </div>
                                                                }
                                                            }
                                                        }
                                                        else
                                                        {
                                                            <div class="alert alert-info p-2 mb-2">
                                                                <i class="bi bi-info-circle"></i> <small>No courses available for <strong>@techEntry.Key</strong> at <strong>@diffLevel.Key</strong> level. Check back soon for more resources!</small>
                                                            </div>
                                                        }
                                                    </div>
                                                </div>
                                            }
                                        }
                                        else
                                        {
                                            <div class="alert alert-info p-2">
                                                <i class="bi bi-info-circle"></i> <small>No learning resources currently available for <strong>@techEntry.Key</strong>. This technology will be added soon!</small>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    }

                    <!-- Not Found Technologies -->
                    @if (learningPathData.not_found != null && learningPathData.not_found.Count > 0)
                    {
                        <div class="alert alert-warning">
                            <i class="bi bi-exclamation-triangle"></i> <strong>Technologies Not Found in Our Library:</strong>
                            <div class="mt-2">
                                @foreach (var tech in learningPathData.not_found)
                                {
                                    <span class="badge bg-secondary me-1 mb-1">@tech</span>
                                }
                            </div>
                            <p class="mt-2 mb-0 small">These technologies are not yet in our learning resource library. We're constantly adding new resources! Please check back soon.</p>
                        </div>
                    }

                    <!-- Data Sources -->
                    <hr />
                    <div class="mt-4">
                        <small class="text-muted">
                            <strong>Data Sources:</strong> Learning resources are curated from multiple providers including Udemy, Coursera, LinkedIn Learning, and official documentation. Future integrations may include additional external learning portal APIs.
                        </small>
                    </div>
                }
                else if (learningPathError != null)
                {
                    <div class="alert alert-danger">
                        <i class="bi bi-exclamation-circle"></i> @learningPathError
                    </div>
                }
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary"
                        @onclick="@(async () => await JS.InvokeVoidAsync("hideModal", "learningPathModal"))">
                    Close
                </button>
            </div>
        </div>
    </div>
</div>

@code {
    private List<JobOpening>? jobOpenings = null;
    private JobOpening? selectedJob = null;
    private bool isLoading = true;
    private bool isLoadingLearningPath = false;
    private string? errorMessage = null;
    private string? learningPathError = null;
    private string selectedDifficulty = "Beginner";

    private dynamic? learningPathData = null;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            jobOpenings = GetSampleJobOpenings();
            isLoading = false;
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading job openings: {ex.Message}";
            isLoading = false;
        }
    }

    private async Task ViewJobDetails(JobOpening job)
    {
        selectedJob = job;
        await JS.InvokeVoidAsync("showModal", "jobDetailsModal");
    }

    private async Task ViewLearningPath(JobOpening job)
    {
        selectedJob = job;
        await FetchLearningPaths();
    }

    private async Task ViewLearningPathForSelected()
    {
        if (selectedJob != null)
        {
            await JS.InvokeVoidAsync("hideModal", "jobDetailsModal");
            await FetchLearningPaths();
        }
    }

    private async Task FetchLearningPaths()
    {
        try
        {
            isLoadingLearningPath = true;
            learningPathError = null;

            var requestData = new
            {
                technologies = selectedJob?.RequiredTechnologies,
                difficulty_level = selectedDifficulty
            };

            var response = await Http.PostAsJsonAsync("http://localhost:5000/learning-paths", requestData);

            if (response.IsSuccessStatusCode)
            {
                var jsonContent = await response.Content.ReadAsStringAsync();
                learningPathData = JsonSerializer.Deserialize<dynamic>(jsonContent);

                await JS.InvokeVoidAsync("showModal", "learningPathModal");
            }
            else
            {
                learningPathError = $"Error loading learning paths: {response.StatusCode}";
            }

            isLoadingLearningPath = false;
        }
        catch (Exception ex)
        {
            learningPathError = $"Error: {ex.Message}";
            isLoadingLearningPath = false;
        }
    }

    private async Task HandleDifficultyChange(string difficulty)
    {
        selectedDifficulty = difficulty;
        if (selectedJob != null)
        {
            await FetchLearningPaths();
        }
    }

    /// <summary>
    /// Safely retrieves a string value from a JsonElement dictionary, with fallback to default value
    /// </summary>
    private string GetJsonElementString(Dictionary<string, JsonElement> obj, string key, string defaultValue = "")
    {
        if (obj == null || !obj.ContainsKey(key))
            return defaultValue;

        try
        {
            var element = obj[key];
            return element.ValueKind == JsonValueKind.String ? element.GetString() ?? defaultValue : element.ToString();
        }
        catch
        {
            return defaultValue;
        }
    }

