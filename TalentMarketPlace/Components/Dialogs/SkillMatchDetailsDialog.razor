@using MudBlazor
@using TalentMarketPlace.Services.Interfaces
@inject IEmployeeService EmployeeService

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.Assessment" Class="mr-2" />
            Skill Match Details - @EmployeeName
        </MudText>
    </TitleContent>
    <DialogContent>
        @if (_isLoading)
        {
            <div class="text-center pa-4">
                <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
                <MudText Typo="Typo.body2" Class="mt-2">Loading skill details...</MudText>
            </div>
        }
        else if (_employee != null && _appliedFilters != null)
        {
            <!-- Overall Match Score -->
            <MudPaper Class="pa-3 mb-3" Elevation="2" Style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white;">
                <div class="d-flex justify-space-between align-center">
                    <div>
                        <MudText Typo="Typo.subtitle2">Overall Match Score</MudText>
                        <MudText Typo="Typo.h3">@MatchPercentage.ToString("0.#")%</MudText>
                    </div>
                    <MudIcon Icon="@Icons.Material.Filled.EmojiEvents" Size="Size.Large" />
                </div>
            </MudPaper>

            <!-- Employee Info Summary -->
            <MudPaper Class="pa-3 mb-3" Elevation="1">
                <MudText Typo="Typo.subtitle2" Class="mb-2">Employee Information</MudText>
                <MudGrid>
                    <MudItem xs="6">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Total Experience</MudText>
                        <MudText Typo="Typo.body2"><strong>@_employee.YearsOfExperience years</strong></MudText>
                    </MudItem>
                    <MudItem xs="6">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Location</MudText>
                        <MudText Typo="Typo.body2"><strong>@(_employee.Location ?? "Not specified")</strong></MudText>
                    </MudItem>
                    <MudItem xs="6">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Availability</MudText>
                        <MudText Typo="Typo.body2"><strong>@_employee.AvailabilityStatus</strong></MudText>
                    </MudItem>
                    <MudItem xs="6">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Designation</MudText>
                        <MudText Typo="Typo.body2"><strong>@(_employee.Designation ?? "Not specified")</strong></MudText>
                    </MudItem>
                </MudGrid>
            </MudPaper>

            <!-- Applied Filters -->
            @if (_appliedFilters.Any())
            {
                <MudPaper Class="pa-3 mb-3" Elevation="1" Style="background-color: #f0f9ff; border-left: 4px solid #3b82f6;">
                    <MudText Typo="Typo.subtitle2" Class="mb-2">
                        <MudIcon Icon="@Icons.Material.Filled.FilterList" Size="Size.Small" Class="mr-1" />
                        Search Criteria
                    </MudText>
                    <div class="d-flex flex-wrap gap-2">
                        @foreach (var filter in _appliedFilters)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled">
                                @filter
                            </MudChip>
                        }
                    </div>
                </MudPaper>
            }

            <!-- Skill Match Details -->
            <MudText Typo="Typo.subtitle2" Class="mb-3">
                <MudIcon Icon="@Icons.Material.Filled.Code" Size="Size.Small" Class="mr-1" />
                Skill Match Analysis
            </MudText>

            <!-- Matched Skills -->
            @if (_matchedSkills.Any())
            {
                <MudText Typo="Typo.subtitle2" Class="mb-2" Color="Color.Success">
                    <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small" Class="mr-1" />
                    Matched Skills (@_matchedSkills.Count)
                </MudText>
                <MudGrid Class="mb-3">
                    @foreach (var skill in _matchedSkills)
                    {
                        var requiredExp = GetRequiredExperience(skill.SkillName);
                        <MudItem xs="12" sm="6" md="4">
                            <MudPaper Class="pa-3" Elevation="1" 
                                     Style="border-left: 4px solid #4caf50; height: 100%;">
                                <div class="d-flex justify-space-between align-center mb-2">
                                    <strong>@skill.SkillName</strong>
                                    <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Size="Size.Small" />
                                </div>
                                @if (requiredExp.HasValue)
                                {
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                                        <strong>@skill.YearsOfExperience.ToString("0.#") / @requiredExp.Value.ToString("0.#") years</strong>
                                    </MudText>
                                }
                                else
                                {
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                                        Experience: <strong>@skill.YearsOfExperience.ToString("0.#") years</strong>
                                    </MudText>
                                }
                                <MudText Typo="Typo.caption" Color="Color.Secondary">
                                    Full Match
                                </MudText>
                                <MudText Typo="Typo.caption" Style="font-size: 11px; color: #666;">
                                    Proficiency: @skill.ProficiencyLevel
                                </MudText>
                                @if (skill.LastUsedDate.HasValue)
                                {
                                    <MudText Typo="Typo.caption" Style="font-size: 11px; color: #666;">
                                        Last used: @skill.LastUsedDate.Value.ToString("MMM yyyy")
                                    </MudText>
                                }
                            </MudPaper>
                        </MudItem>
                    }
                </MudGrid>
            }

            <!-- Partially Matched Skills -->
            @if (_partiallyMatchedSkills.Any())
            {
                <MudText Typo="Typo.subtitle2" Class="mb-2" Color="Color.Warning">
                    <MudIcon Icon="@Icons.Material.Filled.Warning" Size="Size.Small" Class="mr-1" />
                    Partially Matched Skills (@_partiallyMatchedSkills.Count)
                </MudText>
                <MudGrid Class="mb-3">
                    @foreach (var skill in _partiallyMatchedSkills)
                    {
                        var requiredExp = GetRequiredExperience(skill.SkillName);
                        <MudItem xs="12" sm="6" md="4">
                            <MudPaper Class="pa-3" Elevation="1" 
                                     Style="border-left: 4px solid #ff9800; height: 100%;">
                                <div class="d-flex justify-space-between align-center mb-2">
                                    <strong>@skill.SkillName</strong>
                                    <MudIcon Icon="@Icons.Material.Filled.Warning" Color="Color.Warning" Size="Size.Small" />
                                </div>
                                @if (requiredExp.HasValue)
                                {
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                                        <strong>@skill.YearsOfExperience.ToString("0.#") / @requiredExp.Value.ToString("0.#") years</strong>
                                    </MudText>
                                }
                                else
                                {
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                                        Experience: <strong>@skill.YearsOfExperience.ToString("0.#") years</strong>
                                    </MudText>
                                }
                                <MudText Typo="Typo.caption" Color="Color.Secondary">
                                    Partial Match
                                </MudText>
                                <MudText Typo="Typo.caption" Style="font-size: 11px; color: #666;">
                                    Proficiency: @skill.ProficiencyLevel
                                </MudText>
                                @if (skill.LastUsedDate.HasValue)
                                {
                                    <MudText Typo="Typo.caption" Style="font-size: 11px; color: #666;">
                                        Last used: @skill.LastUsedDate.Value.ToString("MMM yyyy")
                                    </MudText>
                                }
                            </MudPaper>
                        </MudItem>
                    }
                </MudGrid>
            }

            <!-- Missing Skills -->
            @if (_missingSkills.Any())
            {
                <MudText Typo="Typo.subtitle2" Class="mb-2" Color="Color.Error">
                    <MudIcon Icon="@Icons.Material.Filled.Cancel" Size="Size.Small" Class="mr-1" />
                    Skills Not Found (@_missingSkills.Count)
                </MudText>
                <MudGrid Class="mb-3">
                    @foreach (var skillName in _missingSkills)
                    {
                        var requiredExp = GetRequiredExperience(skillName);
                        <MudItem xs="12" sm="6" md="4">
                            <MudPaper Class="pa-3" Elevation="1" 
                                     Style="border-left: 4px solid #f44336; height: 100%;">
                                <div class="d-flex justify-space-between align-center mb-2">
                                    <strong>@skillName</strong>
                                    <MudIcon Icon="@Icons.Material.Filled.Cancel" Color="Color.Error" Size="Size.Small" />
                                </div>
                                @if (requiredExp.HasValue)
                                {
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                                        <strong>0 / @requiredExp.Value.ToString("0.#") years</strong>
                                    </MudText>
                                }
                                <MudText Typo="Typo.caption" Color="Color.Secondary">
                                    Missing
                                </MudText>
                                <MudText Typo="Typo.caption" Style="font-size: 11px; color: #666;">
                                    Proficiency: -
                                </MudText>
                            </MudPaper>
                        </MudItem>
                    }
                </MudGrid>
            }

            <!-- Additional Skills -->
            @if (_additionalSkills.Any())
            {
                <MudText Typo="Typo.subtitle2" Class="mb-2" Color="Color.Info">
                    <MudIcon Icon="@Icons.Material.Filled.Add" Size="Size.Small" Class="mr-1" />
                    Additional Skills (@_additionalSkills.Count)
                </MudText>
                <div class="d-flex flex-wrap gap-2 mb-3">
                    @foreach (var skill in _additionalSkills.Take(10))
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Outlined">
                            @skill.SkillName (@skill.YearsOfExperience.ToString("0.#") yr)
                        </MudChip>
                    }
                    @if (_additionalSkills.Count > 10)
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Text">
                            +@(_additionalSkills.Count - 10) more
                        </MudChip>
                    }
                </div>
            }
        }
        else
        {
            <MudAlert Severity="Severity.Warning">
                Unable to load employee details. Please try again.
            </MudAlert>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Close" Color="Color.Primary" Variant="Variant.Filled">Close</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [Parameter]
    public int EmployeeId { get; set; }

    [Parameter]
    public string EmployeeName { get; set; } = string.Empty;

    [Parameter]
    public decimal MatchPercentage { get; set; }

    [Parameter]
    public List<SkillTag> EmployeeSkills { get; set; } = new();

    [Parameter]
    public List<string> AppliedFilters { get; set; } = new();

    private bool _isLoading = true;
    private Employee? _employee;
    private List<string> _appliedFilters = new();
    private List<SkillTag> _matchedSkills = new();
    private List<SkillTag> _partiallyMatchedSkills = new();
    private List<string> _missingSkills = new();
    private List<SkillTag> _additionalSkills = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadEmployeeDetails();
    }

    private async Task LoadEmployeeDetails()
    {
        try
        {
            _isLoading = true;
            
            // Load full employee details
            _employee = await EmployeeService.GetByIdAsync(EmployeeId);
            
            if (_employee != null)
            {
                // Process applied filters
                _appliedFilters = AppliedFilters ?? new List<string>();

                // Categorize skills based on match status
                _matchedSkills = EmployeeSkills.Where(s => s.MatchStatus == "Match").ToList();
                _partiallyMatchedSkills = EmployeeSkills.Where(s => s.MatchStatus == "Partial").ToList();
                
                // Find missing skills from applied filters
                var searchedSkillNames = _appliedFilters
                    .Where(f => f.StartsWith("Mandatory Skills:") || f.StartsWith("Skills:"))
                    .SelectMany(f => f.Split(':')[1].Split(',').Select(s => s.Trim()))
                    .ToList();

                var employeeSkillNames = EmployeeSkills.Select(s => s.SkillName.ToLower()).ToHashSet();
                _missingSkills = searchedSkillNames
                    .Where(s => !employeeSkillNames.Contains(s.ToLower()))
                    .Distinct()
                    .ToList();

                // Find additional skills (not in the search criteria)
                var searchedSkillNamesLower = searchedSkillNames.Select(s => s.ToLower()).ToHashSet();
                _additionalSkills = EmployeeSkills
                    .Where(s => !searchedSkillNamesLower.Contains(s.SkillName.ToLower()) && 
                               s.MatchStatus != "Match" && 
                               s.MatchStatus != "Partial")
                    .ToList();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading employee details: {ex.Message}");
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private decimal? GetRequiredExperience(string skillName)
    {
        // Look for skill-specific experience requirements in applied filters
        // Format: "Python: 5.0+ years" or "SQL Server: 3.0+ years"
        foreach (var filter in _appliedFilters)
        {
            if (filter.Contains(":") && filter.Contains("years"))
            {
                var parts = filter.Split(':');
                if (parts.Length == 2 && parts[0].Trim().Equals(skillName, StringComparison.OrdinalIgnoreCase))
                {
                    // Extract the number from "5.0+ years" or "5 years"
                    var expPart = parts[1].Trim();
                    var match = System.Text.RegularExpressions.Regex.Match(expPart, @"([\d\.]+)");
                    if (match.Success && decimal.TryParse(match.Groups[1].Value, out var years))
                    {
                        return years;
                    }
                }
            }
        }
        return null;
    }

    private void Close()
    {
        // This method can be left empty as MudBlazor DialogService handles closing
    }
}
